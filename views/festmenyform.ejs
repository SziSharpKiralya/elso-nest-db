<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        festmény form
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <form method="POST">
        <label for="title">Cím:</label>
        <input type="text" id="title" name="title" required>

        <label for="painter">Festő:</label>
        <input type="text" id="painter" name="painter" required>

        <label for="painted_at">Képzés dátuma:</label>
        <input type="number" id="painted_at" name="painted_at" required>

        <button type="submit">Festmény hozzáadása</button>
    </form>
</body>

</html>